---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <header class="mb-16 max-w-2xl">
    <div class="flex items-baseline gap-4">
      <h1 class="flex items-center gap-3 text-3xl font-bold text-white">
        <svg class="h-7 w-auto shrink-0" viewBox="1088 85 1001 946" fill="currentColor" role="img" aria-label="One Mo Thought">
        <g transform="scale(8.571428571428573) translate(10, 10)"><g transform="matrix(1.2669493960661524,0,0,1.2669493960661524,114.5206615675041,-5.684645456355392)"><path d="M28.036,91.512c-0.38,0-0.764-0.104-1.096-0.324c-0.708-0.467-1.048-1.332-0.844-2.155l3.552-14.353H15.872  c-0.944,0-1.764-0.656-1.956-1.584L2,16.368c-0.116-0.556,0.004-1.132,0.34-1.588c0.332-0.456,0.84-0.752,1.404-0.813L91.828,4.5  c0.607-0.072,1.22,0.156,1.648,0.592c0.428,0.436,0.631,1.056,0.547,1.66l-7.836,58.191c-0.136,0.992-0.979,1.736-1.983,1.736  H61.216L29.256,91.1C28.892,91.376,28.464,91.512,28.036,91.512L28.036,91.512z"/></g></g>
      </svg>
        <span>Maurice Moore</span>
      </h1>
      <span class="font-mono text-brand-mint text-sm">v2.0.26</span>
    </div>

    <p class="mt-6 text-gray-300 leading-relaxed">
      I design, build, and scale complex systems. Eleven years at Google. Currently a free-agent. Based in Atlanta.
    </p>

    <p class="mt-3 font-mono text-sm text-gray-500">
      Currently building backend engines and agent memory pipelines.
    </p>

    <div class="mt-8 font-mono text-sm flex flex-wrap gap-4 text-gray-400">
      <a href="/logs" class="text-brand-mint hover:text-white transition-colors">System Logs</a>
      <span>//</span>
      <a href="https://github.com/tenxmo" class="hover:text-brand-mint transition-colors">GitHub</a>
      <span>//</span>
      <a href="https://www.linkedin.com/in/maurice-motion/" class="hover:text-brand-mint transition-colors">LinkedIn</a>
      <span>//</span>
      <a href="/resume.pdf" class="hover:text-brand-mint transition-colors">Resume</a>
    </div>
  </header>

  <section class="mb-16">
    <h2 class="font-mono text-lg mb-6 border-b border-gray-800 pb-2 text-white">Active Deployments</h2>
    
    <div class="space-y-4">
      {/* Project 1 */}
      <div class="border border-brand-slate p-6 hover:border-gray-700 transition-colors group">
        <div class="flex justify-between items-baseline mb-2">
          <h3 class="text-lg text-white group-hover:text-brand-mint transition-colors">Epistemic Router</h3>
          <span class="font-mono text-xs text-brand-mint">2026-08</span>
        </div>
        <p class="text-sm text-gray-400 mb-4">
          A deterministic pre-LLM memory ingestion pipeline for autonomous agents. Built to optimize context windows and manage knowledge graphs.
        </p>
        <div class="font-mono text-xs text-gray-500">Tech: Python, asyncio, Cross-encoder Models, LLM Orchestration</div>
      </div>

      {/* Project 2 */}
      <div class="border border-brand-slate p-6 hover:border-gray-700 transition-colors group">
        <div class="flex justify-between items-baseline mb-2">
          <h3 class="text-lg text-white group-hover:text-brand-mint transition-colors">Real-Time Multiplayer Engine</h3>
          <span class="font-mono text-xs text-brand-mint">2026-03</span>
        </div>
        <p class="text-sm text-gray-400 mb-4">
          Server-authoritative game engine built to handle concurrent state resolution for a custom card game.
        </p>
        <div class="font-mono text-xs text-gray-500">Tech: Go, Flutter Web, WebSockets</div>
      </div>
    </div>
  </section>
</BaseLayout>
