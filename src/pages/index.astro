---
import BaseLayout from '../layouts/BaseLayout.astro';

const navLinks = [
  { href: '/logs', label: 'System Logs', accent: true },
  { href: '/consulting', label: 'Consulting' },
  { href: 'https://github.com/tenxmo', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/maurice-motion/', label: 'LinkedIn' },
  { href: '/resume.pdf', label: 'Resume' },
];

const credentials = [
  'Eleven years at Google',
  'Independent consulting — One Mo Solutions',
  'Based in Atlanta',
];
---

<BaseLayout>
  <header class="mb-16 max-w-2xl">
    <svg class="h-10 w-auto text-white" viewBox="1088 85 1001 946" fill="currentColor" role="img" aria-label="One Mo Thought">
      <g transform="scale(8.571428571428573) translate(10, 10)"><g transform="matrix(1.2669493960661524,0,0,1.2669493960661524,114.5206615675041,-5.684645456355392)"><path d="M28.036,91.512c-0.38,0-0.764-0.104-1.096-0.324c-0.708-0.467-1.048-1.332-0.844-2.155l3.552-14.353H15.872  c-0.944,0-1.764-0.656-1.956-1.584L2,16.368c-0.116-0.556,0.004-1.132,0.34-1.588c0.332-0.456,0.84-0.752,1.404-0.813L91.828,4.5  c0.607-0.072,1.22,0.156,1.648,0.592c0.428,0.436,0.631,1.056,0.547,1.66l-7.836,58.191c-0.136,0.992-0.979,1.736-1.983,1.736  H61.216L29.256,91.1C28.892,91.376,28.464,91.512,28.036,91.512L28.036,91.512z"/></g></g>
    </svg>

    <div class="mt-5 flex items-baseline gap-x-4 gap-y-1 flex-wrap">
      <h1 class="text-3xl font-bold text-white">Maurice Moore</h1>
      <span class="font-mono text-brand-mint text-sm">v2.0.26</span>
    </div>

    <p class="mt-6 text-gray-300 leading-relaxed">
      I design, build, and scale complex systems.
    </p>

    <p class="mt-4 text-gray-400 leading-relaxed">
      Iteratively shrinking the surface area of what I don't understand.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-y-1 font-mono text-xs text-gray-500">
      {credentials.map((item) => (
        <span class="whitespace-nowrap after:mx-2.5 after:text-gray-700 after:content-['|'] last:after:content-none">{item}</span>
      ))}
    </div>

    <nav class="mt-8 font-mono text-sm text-gray-400 flex flex-wrap items-center gap-y-2 max-[420px]:grid max-[420px]:grid-cols-2 max-[420px]:gap-x-4 max-[420px]:gap-y-3">
      {navLinks.map((link) => (
        <span class="inline-flex items-center whitespace-nowrap after:mx-2.5 after:text-gray-600 after:content-['•'] last:after:content-none max-[420px]:after:content-none">
          <a href={link.href} class={link.accent
            ? "text-brand-mint hover:text-white transition-colors"
            : "hover:text-brand-mint transition-colors"}>{link.label}</a>
        </span>
      ))}
    </nav>
  </header>

  <section class="mb-16">
    <h2 class="font-mono text-lg mb-6 border-b border-gray-800 pb-2 text-white">Active Deployments</h2>
    
    <div class="space-y-4">
      {/* Project 1 */}
      <div class="border border-brand-slate p-6 hover:border-gray-700 transition-colors group">
        <div class="flex justify-between items-baseline mb-2">
          <h3 class="text-lg text-white group-hover:text-brand-mint transition-colors">Epistemic Router</h3>
          <span class="font-mono text-xs text-brand-mint">2026-08</span>
        </div>
        <p class="text-sm text-gray-400 mb-4">
          A deterministic <span class="whitespace-nowrap">pre-LLM</span> memory ingestion pipeline for autonomous agents. Built to optimize context windows and manage knowledge graphs.
        </p>
        <div class="font-mono text-xs text-gray-500">Tech: Python, asyncio, <span class="whitespace-nowrap">Cross-encoder</span> Models, LLM Orchestration</div>
      </div>

      {/* Project 2 */}
      <div class="border border-brand-slate p-6 hover:border-gray-700 transition-colors group">
        <div class="flex justify-between items-baseline mb-2">
          <h3 class="text-lg text-white group-hover:text-brand-mint transition-colors"><span class="whitespace-nowrap">Real-Time</span> Multiplayer Engine</h3>
          <span class="font-mono text-xs text-brand-mint">2026-03</span>
        </div>
        <p class="text-sm text-gray-400 mb-4">
          <span class="whitespace-nowrap">Server-authoritative</span> game engine built to handle concurrent state resolution for a custom card game.
        </p>
        <div class="font-mono text-xs text-gray-500">Tech: Go, Flutter Web, WebSockets</div>
      </div>
    </div>
  </section>
</BaseLayout>
