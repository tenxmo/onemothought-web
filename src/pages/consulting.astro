---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/consulting/Hero.astro';
import Engagement from '../components/consulting/Engagement.astro';
import HowItRuns from '../components/consulting/HowItRuns.astro';
import Background from '../components/consulting/Background.astro';
import WritingLink from '../components/consulting/WritingLink.astro';
import Contact from '../components/consulting/Contact.astro';
import Terms from '../components/consulting/Terms.astro';
import Footer from '../components/consulting/Footer.astro';
---

<BaseLayout
  title="Consulting | Maurice Moore"
  description="Fixed-fee technical assessments for backend systems that carry revenue — billing, payments, and the platforms underneath them."
>
  {/*
    The safe-area inset now lives on the body in BaseLayout, which covers
    every route. This wrapper stays for its `flex flex-1 flex-col`: it keeps
    the body's flex column intact so Footer's mt-auto still applies.
  */}
  <div class="flex flex-1 flex-col">
    <Hero />
    <Engagement />
    <HowItRuns />
    <Background />
    <WritingLink />
    <Contact />
    <Terms />
    <Footer />
  </div>
</BaseLayout>
