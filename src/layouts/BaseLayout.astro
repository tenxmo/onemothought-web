---
import '@fontsource/geist-sans';
import '@fontsource/jetbrains-mono';
import '../styles/global.css';

const { title = "Maurice Moore | Software Engineer" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col pt-12 pb-24 px-6 md:px-12 max-w-4xl mx-auto">
    <slot />
  </body>
</html>
